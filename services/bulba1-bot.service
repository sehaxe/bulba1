[Unit]
Description=Bulba1 Telegram Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/bulba1-python
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/bulba1-python
ExecStart=%h/bulba1-python/.venv/bin/python -m telegram_bot.bot
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target