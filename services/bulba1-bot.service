[Unit]
Description=Bulba1 Telegram Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/bulba1-python
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/uv run --directory %h/bulba1-python python telegram_bot/bot.py --poll
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target