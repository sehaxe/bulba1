[Unit]
Description=Bulba1 Autonomous Training (27M params)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/bulba1-python
ExecStart=/usr/bin/uv run -m bulba1.cli --config configs/default.yaml --auto
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:%h/bulba1-python/logs/bulba1.log
StandardError=append:%h/bulba1-python/logs/bulba1.log
Restart=no

[Install]
WantedBy=default.target