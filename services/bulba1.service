[Unit]
Description=Bulba1 Training (default config)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/bulba1-python
ExecStart=%h/bulba1-python/.venv/bin/python -m bulba1.cli --config configs/default.yaml
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:%h/bulba1-python/logs/bulba1.log
StandardError=append:%h/bulba1-python/logs/bulba1.log
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target