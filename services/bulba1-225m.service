[Unit]
Description=Bulba1-225M Training Service
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/bulba1-python
ExecStart=%h/bulba1-python/.venv/bin/python run_225m.py
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:%h/bulba1-python/logs/bulba1_225m.log
StandardError=append:%h/bulba1-python/logs/bulba1_225m.log
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target